# Frontend: live Google authentication is the default. Use npm run dev:demo for a separate fictional demo.
VITE_APP_MODE=live
# Leave empty when using Vite's /api proxy. Otherwise use an HTTPS API origin.
VITE_API_URL=
# Local development database; see README for loopback-only Docker setup.
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/nsut_connect
# Vercel production builds apply migrations using a direct connection (Neon pooling disabled).
DIRECT_DATABASE_URL=
TEST_DATABASE_URL=postgresql://postgres@127.0.0.1:5432/nsut_connect_test
CLIENT_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:3001
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Trusted operator-only allowlist; never take this from a user's form.
ADMIN_EMAILS=
PORT=3001
NODE_ENV=development
SEED_DEMO_DATA=false
